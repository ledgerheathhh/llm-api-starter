# Active LLM provider.
# Supported values: deepseek, mistral, openrouter.
# Only the API key for the selected provider is required.
LLM_PROVIDER=deepseek

# DeepSeek
# Required when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-chat when omitted.
DEEPSEEK_MODEL=deepseek-v4-pro

# Mistral AI
# Required when LLM_PROVIDER=mistral.
MISTRAL_API_KEY=
# Optional. Defaults to mistral-small-latest when omitted.
MISTRAL_MODEL=mistral-small-latest

# OpenRouter
# Required when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Optional. Use an OpenRouter model identifier.
# Defaults to deepseek/deepseek-chat when omitted.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# Optional. Sent to OpenRouter as the HTTP-Referer header.
# Use the public URL of the application that is making the request.
# Defaults to http://localhost:8000 when omitted.
OPENROUTER_SITE_URL=https://openrouter.ai/api/v1
# Optional. Sent to OpenRouter as the X-Title header.
# Defaults to LLM API Starter when omitted.
OPENROUTER_APP_NAME=LLM API Starter
